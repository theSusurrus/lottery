import {
    AboutSlint,
    Button,
    StandardButton,
    VerticalBox,
    LineEdit,
    HorizontalBox,
    ListView,
    ScrollView,
    StandardButton,
    Palette, TextEdit
} from "std-widgets.slint";

export component PasteWindow inherits Window {
    title: "Loteria Paste";
    out property <string> names;

    callback names_ready;

    min-width: 400px;
    min-height: 400px;

    Rectangle {
        vertical-stretch: 0;
        background: Palette.background;
        border-color: Palette.foreground;
        VerticalBox {
            alignment: stretch;
            padding: 15px;
            TextEdit {
                text: names;
                preferred-height: 400px;
                edited(text) => {
                    names = text;
                }
            }
            Button {
                height: 100px;
                text: "Załaduj";
                clicked => {
                    names_ready();
                }
            }
        }
    }
    
}

export component AppWindow inherits Window {
    title: "Loteria";

    callback draw_person;
    callback reset;

    in-out property <string> status;
    in-out property <string> list;
    in-out property <string> winner;

    min-width: 500px;
    min-height: 500px;
    background: Palette.background;

    Rectangle {
        background: Palette.background;
        popup := PopupWindow {
            x: parent.width / 3;
            y: parent.height / 2;
            width: parent.width / 3;
            Rectangle {
                height:100%;
                width: 100%;
                background: Palette.background;
                border-color: Palette.foreground;
                border-radius: 10px;
                border-width: 2px;
                VerticalBox {
                    padding: 15px;
                    spacing: 10px;
                    Text {
                        font-size: 20px;
                        horizontal-alignment: center;
                        text: "Przeładować listę?";
                        color: red;
                    }
                    HorizontalBox {
                        alignment: stretch;
                        Button {
                            text: "Tak";
                            clicked => {
                                popup.close();
                                reset();
                            }
                        }
                        Button {
                            text: "Nie";
                            clicked => {
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
        VerticalBox {
            ScrollView {
                vertical-scrollbar-policy: always-on;
                viewport-height: 2000px;
                Text {
                    y: 0;
                    text: list;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                }
            }
            VerticalLayout {
                alignment: end;
                VerticalBox {
                    Text {
                        text: status;
                        font-size: 16px;
                        horizontal-alignment: center;
                        color: Palette.foreground;
                    }
                    Text {
                        text: winner;
                        font-size: 24px;
                        horizontal-alignment: center;
                        color: Palette.foreground;
                    }
                }
                Button {
                    text: "Wylosuj";
                    clicked => { draw_person() }
                }
                Button {
                    text: "Restart";
                    clicked => { popup.show() }
                }
            }
        }
    }
}
